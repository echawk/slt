(in-package #:slt)

;;; X11-style modifier bits, which backends normalize their events to.
(defconstant +shift-mask+ #x01)
(defconstant +control-mask+ #x04)
(defconstant +mod1-mask+ #x08)
(defconstant +mod4-mask+ #x40)
(defconstant +escape-char+ (code-char 27))
(defconstant +rubout-char+ (code-char 127))

(defparameter *keysym-map*
  '(("BackSpace" . :backspace)
    ("Delete" . :delete)
    ("Down" . :down)
    ("End" . :end)
    ("Escape" . :escape)
    ("Home" . :home)
    ("Insert" . :insert)
    ("ISO_Left_Tab" . :tab)
    ("KP_Delete" . :delete)
    ("KP_Down" . :down)
    ("KP_End" . :end)
    ("KP_Enter" . :enter)
    ("KP_Home" . :home)
    ("KP_Insert" . :insert)
    ("KP_Left" . :left)
    ("KP_Next" . :page-down)
    ("KP_Prior" . :page-up)
    ("KP_Right" . :right)
    ("KP_Up" . :up)
    ("Left" . :left)
    ("Next" . :page-down)
    ("Page_Down" . :page-down)
    ("Page_Up" . :page-up)
    ("Prior" . :page-up)
    ("Return" . :enter)
    ("Right" . :right)
    ("Tab" . :tab)
    ("Up" . :up))
  "X11 keysym names mapped to key keywords understood by ENGINE-ENCODE-KEY.")

(defun decode-modifier-state (state)
  (let (modifiers)
    (when (logtest +shift-mask+ state)
      (push :shift modifiers))
    (when (logtest +control-mask+ state)
      (push :control modifiers))
    (when (logtest +mod1-mask+ state)
      (push :meta modifiers))
    (when (logtest +mod4-mask+ state)
      (push :super modifiers))
    (nreverse modifiers)))

(defun keysym->terminal-key (keysym)
  (cond
    ((null keysym) nil)
    ((assoc keysym *keysym-map* :test #'string=)
     (cdr (assoc keysym *keysym-map* :test #'string=)))
    ((and (> (length keysym) 1)
          (char= (aref keysym 0) #\F)
          (every #'digit-char-p (subseq keysym 1)))
     (intern keysym :keyword))
    ((and (> (length keysym) 3)
          (string= "KP_" keysym :end2 3)
          (= (length keysym) 4)
          (digit-char-p (aref keysym 3)))
     (aref keysym 3))
    (t nil)))

(defun event-character (char keysym)
  (cond
    ((and char (plusp (length char)))
     (aref char 0))
    ((and keysym (= (length keysym) 1))
     (aref keysym 0))
    ((and keysym (string= keysym "space"))
     #\Space)
    (t nil)))

(defun event-key (char keysym)
  "The key for a backend event: a key keyword, a character, or NIL."
  (let ((special (keysym->terminal-key keysym)))
    (or special (event-character char keysym))))

(defun translate-key-event (engine char keysym state)
  "Encode a backend key event for the child process using ENGINE."
  (let ((key (event-key char keysym))
        (modifiers (decode-modifier-state state)))
    (when key
      (engine-encode-key engine key modifiers))))
