#!/usr/bin/env sh
# Fetch only the Lisp dependencies of a lean build (make lean-FRONTEND,
# make LEAN=1) into DIR/ocicl, at the versions pinned in ocicl.csv.
# Usage: scripts/fetch-lean DIR SYSTEM...
#
# `ocicl install` would fetch everything in ocicl.csv (ghostty-vt, ltk, the
# web stack, ...).  Instead the SYSTEMs are loaded, and each system ASDF
# reports missing is looked up in ocicl.csv and fetched by its digest:
# `ocicl install` run in DIR with a csv of just the needed entries.
# That fetches exactly those entries and nothing else.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$1"
lean=$(cd "$1" && pwd)
shift
: "${OCICL:=ocicl}"
export OCICL
SLT_OCICL="$lean/ocicl" SLT_LEAN_DIR="$lean" SLT_ROOT="$root" "$root/scripts/lisp" \
  --eval '(defpackage #:slt-fetch-lean (:use #:cl))' \
  --eval '(in-package #:slt-fetch-lean)' \
  --eval '
(let* ((lean (uiop:ensure-directory-pathname (uiop:getenv "SLT_LEAN_DIR")))
       (pins (with-open-file (in (merge-pathnames "ocicl.csv" (uiop:ensure-directory-pathname
                                                         (uiop:getenv "SLT_ROOT"))))
               (loop for line = (read-line in nil)
                     while line
                     collect (cons (subseq line 0 (position #\, line)) line))))
       (fetched (with-open-file (in (merge-pathnames "ocicl.csv" lean)
                                    :if-does-not-exist nil)
                  (and in (loop for line = (read-line in nil)
                                while line
                                collect line))))
       (systems (uiop:command-line-arguments)))
  (loop
    (handler-case
        (progn (mapc (function asdf:load-system) systems)
               (return))
      (asdf:missing-component (condition)
        (let* ((name (string-downcase
                      (asdf/find-component:missing-requires condition)))
               (pin (cdr (assoc name pins :test (function string=)))))
          (unless pin
            (error "~a is needed but not pinned in ocicl.csv." name))
          (when (member pin fetched :test (function string=))
            (error "~a was fetched but ASDF still cannot find it." name))
          (format t "~&; fetching ~a~%" name)
          (push pin fetched)
          (with-open-file (out (merge-pathnames "ocicl.csv" lean)
                               :direction :output :if-exists :supersede)
            (format out "~{~a~%~}" (reverse fetched)))
          (uiop:run-program (list (uiop:getenv "OCICL") "install")
                            :directory lean :output t :error-output t)
          (asdf:clear-source-registry))))))' \
  --end-toplevel-options "$@"
