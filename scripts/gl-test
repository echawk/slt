#!/usr/bin/env sh
# Smoke-test the gl backend (t/gl-snapshot.lisp).  Needs a display: on
# Linux CI run it under xvfb-run, or under `weston --backend=headless` with
# WAYLAND_DISPLAY set.  SLT_ENGINE picks the engine (default 3bst).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
exec "$root/scripts/lisp" --non-interactive --load "$root/t/gl-snapshot.lisp"
