#!/usr/bin/env sh
# Run a command in the Linux test container (ci/linux.Containerfile), with
# this checkout mounted at the same path: e.g. scripts/linux-test make test.
# SLT_PODMAN_CONNECTION names the Podman machine's connection to use.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
podman="${PODMAN:-podman}${SLT_PODMAN_CONNECTION:+ --connection $SLT_PODMAN_CONNECTION}"
# shellcheck disable=SC2086 # podman's options are intentionally split
$podman build -q -t slt-linux-test -f "$root/ci/linux.Containerfile" "$root/ci" >/dev/null
# shellcheck disable=SC2086
exec $podman run --rm -i --init -v "$root:$root" -w "$root" slt-linux-test "$@"
