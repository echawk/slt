#!/usr/bin/env sh
# Run SBCL with ASDF confined to this project and its ocicl/ dependency tree
# ($SLT_OCICL, default ocicl/; lean builds use build/lean/ocicl).
# Usage: scripts/lisp --eval '...' [...]
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
: "${SBCL:=sbcl}"
export XDG_CACHE_HOME="$root/.cache"
: "${SLT_OCICL:=$root/ocicl}"
export CL_SOURCE_REGISTRY="$root/:$SLT_OCICL//:$root/lib//"
core_args=""
if [ -n "${SBCL_CORE:-}" ]; then core_args="--core $SBCL_CORE"; fi
# shellcheck disable=SC2086 # core_args is intentionally split
exec "$SBCL" $core_args --dynamic-space-size "${SLT_HEAP_MB:-4096}" --noinform --no-sysinit --no-userinit --non-interactive \
  --eval '(require :asdf)' \
  --eval '(setf uiop/lisp-build:*compile-file-warnings-behaviour* :warn uiop/lisp-build:*compile-file-failure-behaviour* :warn)' \
  "$@"
