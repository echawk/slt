#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")"
separator=$(printf '\037')
cli_args=""

if [ "$#" -gt 0 ]; then
  cli_args=$1
  shift
  for arg in "$@"; do
    cli_args="${cli_args}${separator}${arg}"
  done
fi

SLT_CLI_ARGS="$cli_args" exec scripts/lisp \
  --eval '(asdf:load-system :slt)' \
  --eval '(slt:main)'
