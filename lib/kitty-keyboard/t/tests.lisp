(defpackage #:kitty-keyboard/tests
  (:use #:cl #:kitty-keyboard)
  (:export #:run-tests))

(in-package #:kitty-keyboard/tests)

(defvar *failures* 0)

(defun check (expected actual form)
  (unless (equal expected actual)
    (incf *failures*)
    (format t "~&FAIL: ~s~%  expected ~s~%  got      ~s~%" form expected actual)))

(defun e (string)
  "STRING with \\e for ESC, \\t, \\r, \\b and \\0."
  (with-output-to-string (out)
    (loop with i = 0
          while (< i (length string))
          do (let ((char (char string i)))
               (if (and (char= char #\\) (< (1+ i) (length string)))
                   (progn
                     (write-char (ecase (char string (1+ i))
                                   (#\e (code-char 27)) (#\t (code-char 9))
                                   (#\r (code-char 13)) (#\b (code-char 8))
                                   (#\0 (code-char 0)) (#\d (code-char 127)))
                                 out)
                     (incf i 2))
                   (progn (write-char char out) (incf i)))))))

(defmacro enc (expected flags key &rest arguments)
  `(check (and ,expected (e ,expected)) (encode-key ,flags ,key ,@arguments)
          '(encode-key ,flags ,key ,@arguments)))

(defun test-legacy ()
  ;; The spec's example table.
  (enc "i" 0 #\i :text "i")
  (enc "I" 0 #\i :modifiers '(:shift) :text "I")
  (enc "\\ei" 0 #\i :modifiers '(:alt))
  (enc "\\t" 0 #\i :modifiers '(:control))
  (enc "\\eI" 0 #\i :modifiers '(:shift :alt))
  (enc "\\e\\t" 0 #\i :modifiers '(:alt :control))
  (enc "\\e[105;6u" 0 #\i :modifiers '(:control :shift))
  (enc "#" 0 #\3 :modifiers '(:shift) :text "#")
  (enc "\\e" 0 #\3 :modifiers '(:control))
  (enc "\\e\\e" 0 #\3 :modifiers '(:alt :control))
  (enc ";" 0 #\; :modifiers '(:control))
  (enc "\\e:" 0 #\; :modifiers '(:shift :alt))
  ;; C0 keys.
  (enc "\\r" 0 :enter)
  (enc "\\e\\r" 0 :enter :modifiers '(:alt))
  (enc "\\d" 0 :backspace)
  (enc "\\b" 0 :backspace :modifiers '(:control))
  (enc "\\e[Z" 0 :tab :modifiers '(:shift))
  (enc "\\e\\e[Z" 0 :tab :modifiers '(:shift :alt))
  (enc "\\e\\t" 0 :tab :modifiers '(:control :alt))
  (enc "\\e" 0 :escape)
  (enc "\\e\\e" 0 :escape :modifiers '(:alt))
  (enc "\\0" 0 #\Space :modifiers '(:control))
  ;; Functional keys.
  (enc "\\e[A" 0 :up)
  (enc "\\eOA" 0 :up :application-cursor-keys t)
  (enc "\\e[1;5A" 0 :up :modifiers '(:control) :application-cursor-keys t)
  (enc "\\eOP" 0 :f1)
  (enc "\\e[1;5P" 0 :f1 :modifiers '(:control))
  (enc "\\e[13~" 0 :f3)
  (enc "\\e[15;2~" 0 :f5 :modifiers '(:shift))
  (enc "\\e[29~" 0 :menu)
  (enc "\\e[57376u" 0 :f13)
  (enc "5" 0 :kp-5)
  (enc "\\r" 0 :kp-enter)
  ;; No releases, no lone modifiers.
  (enc nil 0 #\a :event :release :text "a")
  (enc nil 0 :left-shift :modifiers '(:shift)))

(defun test-disambiguate ()
  (enc "\\e[27u" 1 :escape)
  (enc "\\e[97;5u" 1 #\a :modifiers '(:control))
  (enc "\\e[97;3u" 1 #\a :modifiers '(:alt))
  (enc "a" 1 #\a :text "a")
  (enc "A" 1 #\a :modifiers '(:shift) :text "A")
  (enc "\\e[A" 1 :up)
  (enc "\\e[1;5A" 1 :up :modifiers '(:control))
  (enc "\\e[P" 1 :f1)
  (enc "\\e[15~" 1 :f5)
  (enc "\\r" 1 :enter)
  (enc "\\e[13;5u" 1 :enter :modifiers '(:control))
  (enc "\\e[57414u" 1 :kp-enter)
  (enc "0" 1 :kp-0 :text "0")
  ;; Event types.
  (enc "\\e[1;1:3A" 3 :up :event :release)
  (enc "\\e[1;1:2A" 3 :up :event :repeat)
  (enc "\\e[A" 1 :up :event :repeat)
  (enc nil 3 #\a :event :release :text "a")
  (enc nil 3 :enter :event :release))

(defun test-report-all ()
  (enc "\\e[97u" 8 #\a :text "a")
  (enc "\\e[97;;97u" 24 #\a :text "a")
  (enc "\\e[97;2;65u" 24 #\a :modifiers '(:shift) :text "A")
  (enc "\\e[97;1:3u" 26 #\a :event :release :text "a")
  (enc "\\e[13u" 8 :enter)
  (enc "\\e[57441;2u" 8 :left-shift :modifiers '(:shift))
  (enc "\\e[97;65u" 8 #\a :modifiers '(:caps-lock) :text "A")
  ;; Alternate keys appear only with Shift.
  (enc "\\e[97:65;2u" 12 #\a :modifiers '(:shift) :shifted-key #\A :text "A")
  (enc "\\e[97u" 12 #\a :shifted-key #\A :text "a")
  (enc "\\e[1089::99;5u" 13 (code-char 1089) :modifiers '(:control) :base-key #\c)
  ;; Pure text input.
  (enc "\\e[0;;229u" 24 nil :text (string (code-char 229)))
  (enc "å" 0 nil :text "å"))

(defun test-state ()
  (let ((state (make-keyboard-state)))
    (check 0 (keyboard-flags state :primary) "initial")
    (keyboard-control-sequence state :primary #\= '(5))
    (check 5 (keyboard-flags state :primary) "set")
    (keyboard-control-sequence state :primary #\= '(2 2))
    (check 7 (keyboard-flags state :primary) "or")
    (keyboard-control-sequence state :primary #\= '(1 3))
    (check 6 (keyboard-flags state :primary) "and-not")
    (keyboard-control-sequence state :primary #\> '(1))
    (check 1 (keyboard-flags state :primary) "push")
    (check 0 (keyboard-flags state :alternate) "screens are separate")
    (check (e "\\e[?1u") (nth-value 1 (keyboard-control-sequence state :primary #\? '()))
           "query")
    (keyboard-control-sequence state :primary #\< '())
    (check 6 (keyboard-flags state :primary) "pop")
    (keyboard-control-sequence state :primary #\< '(5))
    (check 0 (keyboard-flags state :primary) "pop past the bottom resets")
    (dotimes (i 40) (keyboard-push state :alternate 3))
    (check 16 (length (slot-value (slot-value state 'kitty-keyboard::alternate)
                                  'kitty-keyboard::stack))
           "bounded stack")))

(defun run-tests ()
  (setf *failures* 0)
  (test-legacy)
  (test-disambiguate)
  (test-report-all)
  (test-state)
  (format t "~&kitty-keyboard: ~:[~d failure~:p~;all tests passed~]~%"
          (zerop *failures*) *failures*)
  (zerop *failures*))
